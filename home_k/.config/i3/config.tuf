# vim:set noet ft=i3config:
include ~/.config/i3/config.local
include base
include common
include common-i3

# Laptop hardware controls
exec --no-startup-id "command -v blueman-applet >/dev/null && blueman-applet"
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%

set $scratch_width 1920
set $scratch_height 1200
for_window [title="my-init-terminal"] resize set $scratch_width $scratch_height
exec --no-startup-id "command -v rog-control-center >/dev/null && rog-control-center"
bindsym XF86Launch3 exec --no-startup-id rog-control-center
